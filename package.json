    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:e2e": "node scripts/build-e2e.mjs",
        "compile-python": ".venv-nuitka-build\\Scripts\\python.exe scripts/compile_python_nuitka.py",
        "bootstrap-python:macos": "python3.12 scripts/bootstrap_python_macos.py",
        "compile-python:macos": "node scripts/compile-python-macos.mjs",
        "test:compile-python": "PYTHONPATH=scripts python3.12 -m unittest scripts/test_bootstrap_python_macos.py scripts/test_compile_python_nuitka.py && node --test scripts/compile-python-macos.test.mjs",
        "test:runtime-platform": "node --test scripts/python-runtime-constants.test.mjs",
        "rnaseq:cache:refresh": "python_embedded\\python.exe scripts/generate_rnaseq_gene_caches.py",
        "updater:json": "node scripts/generate-updater-json.mjs",
        "updater:json:dry": "node scripts/generate-updater-json.mjs --dry-run",
        "stage-python-runtime": "node scripts/stage_python_runtime.mjs",
        "compile-python:check": "node scripts/validate_release.js",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "tauri:build:e2e": "node scripts/tauri-build-e2e.mjs",
        "tauri:build:release:nsis": "node scripts/tauri-build-release-nsis.mjs",
        "e2e": "node e2e/run-tests.mjs",
        "e2e:smoke": "node e2e/run-tests.mjs smoke --mode=release",
        "e2e:smoke:release": "node e2e/run-tests.mjs smoke --mode=release",
        "e2e:prepare:e2e-binary": "npm run -s tauri:build:e2e",
        "e2e:smoke:e2e": "npm run -s e2e:prepare:e2e-binary && node e2e/run-tests.mjs smoke --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe",
        "e2e:auth": "npm run -s e2e:prepare:e2e-binary && node e2e/run-tests.mjs features/auth --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe",
        "e2e:grid:fast": "node e2e/run-tests.mjs features/grid --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe",
        "e2e:grid": "npm run -s e2e:prepare:e2e-binary && npm run -s e2e:grid:fast",
        "e2e:grid:lmm:local": "node e2e/run-tests.mjs features/grid/grid.lmm-overflow-paste.local.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe",
        "e2e:grid:large-paste:local": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:E2E_TEST_TIMEOUT_MS='660000'; node e2e/run-tests.mjs features/grid/grid.paste-overflow-batch-perf.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe\"",
        "e2e:grid:large-paste:hydration:local": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:E2E_TEST_TIMEOUT_MS='660000'; node e2e/run-tests.mjs features/grid/grid.large-paste-visible-hydration.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe\"",
        "e2e:grid:large-paste:undo-redo:local": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:E2E_TEST_TIMEOUT_MS='660000'; node e2e/run-tests.mjs features/grid/grid.large-paste-undo-redo.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe\"",
        "e2e:grid:large-paste:undo-lock:local": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:E2E_TEST_TIMEOUT_MS='660000'; node e2e/run-tests.mjs features/grid/grid.backend-paste-undo-lock.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe\"",
        "e2e:grid:large-paste:all": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:E2E_TEST_TIMEOUT_MS='660000'; node e2e/run-tests.mjs features/grid/grid.paste-overflow-batch-perf.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node e2e/run-tests.mjs features/grid/grid.large-paste-visible-hydration.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node e2e/run-tests.mjs features/grid/grid.large-paste-undo-redo.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node e2e/run-tests.mjs features/grid/grid.backend-paste-undo-lock.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe\"",
        "e2e:grid:family-switch:local": "node e2e/run-tests.mjs features/grid/grid.family-switch-persistence.local.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe",
        "e2e:grid:lmm:confirm": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:E2E_LMM_FIXTURES='1'; npm run -s e2e:grid:fast; if ($LASTEXITCODE -eq 0) { npm run -s e2e:grid:lmm:local } else { exit $LASTEXITCODE }\"",
        "e2e:remote:protocol-link": "npm run -s e2e:prepare:e2e-binary && npm run -s e2e:remote:protocol-link:run",
        "e2e:remote:protocol-link:run": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:E2E_REMOTE_PROTOCOL_LINK='1'; node e2e/run-tests.mjs features/remote/remote.protocol-link.local.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe\"",
        "e2e:remote:protocol-link:cloud": "node scripts/run-cloud-protocol-link-e2e.mjs",
        "e2e:remote:protocol-link:cloud:run": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:E2E_REMOTE_PROTOCOL_LINK_CLOUD='1'; node e2e/run-tests.mjs features/remote/remote.protocol-link-cloud.local.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe\"",
        "e2e:remote:host-controls": "npm run -s e2e:prepare:e2e-binary && npm run -s e2e:remote:host-controls:run",
        "e2e:remote:host-controls:run": "node e2e/run-tests.mjs features/remote/remote-host-controls.local.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe",
        "e2e:remote:native-capture": "npm run -s e2e:prepare:e2e-binary && npm run -s e2e:remote:native-capture:run",
        "e2e:remote:native-capture:run": "node e2e/run-tests.mjs features/remote/remote-session.native-capture.local.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe",
        "e2e:remote:native-capture-geometry": "npm run -s e2e:prepare:e2e-binary && npm run -s e2e:remote:native-capture-geometry:run",
        "e2e:remote:native-capture-geometry:run": "node e2e/run-tests.mjs features/remote/remote-session.native-capture-geometry.local.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe",
        "e2e:remote:webview-resize-repaint": "npm run -s e2e:prepare:e2e-binary && npm run -s e2e:remote:webview-resize-repaint:run",
        "e2e:remote:webview-resize-repaint:run": "node e2e/run-tests.mjs features/remote/remote-session.webview-resize-repaint.local.test.mjs --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe",
        "e2e:remote:cloud": "node scripts/run-cloud-remote-e2e.mjs",
        "e2e:remote:cloud:live": "node scripts/run-cloud-remote-live-e2e.mjs",
        "remote:mock-relay": "node scripts/start-cloud-signaling-mock.mjs",
        "e2e:r-validation": "npm run -s e2e:prepare:e2e-binary && node e2e/run-tests.mjs features/r-validation --mode=e2e --app-path=src-tauri/target/e2e/release/easycris.exe",
        "e2e:r-validation:lmm": "npm run -s e2e:prepare:e2e-binary && node e2e/run-lmm-r-validation.mjs",
        "e2e:single": "node",
        "rust:fmt": "source ~/.cargo/env && cd src-tauri && cargo fmt",
        "rust:fmt:check": "source ~/.cargo/env && cd src-tauri && cargo fmt --check",
        "rust:clippy": "source ~/.cargo/env && cd src-tauri && cargo clippy -- -D warnings",
        "rust:clippy:fix": "source ~/.cargo/env && cd src-tauri && cargo clippy --fix --allow-dirty",
        "rust:test": "source ~/.cargo/env && cd src-tauri && cargo test",
        "tauri": "node scripts/tauri-cli.mjs",
        "tauri:dev": "source ~/.cargo/env && node scripts/tauri-cli.mjs dev",
        "tauri:dev:remote-pair": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:EASYCRIS_DISABLE_SINGLE_INSTANCE='1'; node scripts/tauri-cli.mjs dev\"",
        "tauri:build:raw": "npm run tauri build",
        "tauri:build": "npm run tauri:build:release:nsis",
        "tauri:check": "npm run typecheck && npm run tauri build --check",
        "isolation:allowlist:check": "node scripts/check-isolation-allowlist.mjs",
        "test:all": "npm run test:run && npm run rust:test",
        "check:all": "npm run typecheck && npm run isolation:allowlist:check && npm run lint && npm run format:check && npm run rust:fmt:check && npm run rust:clippy && npm run test:run && npm run rust:test",
        "fix:all": "npm run lint:fix && npm run format && npm run rust:fmt && npm run rust:clippy:fix",
        "build:analyze": "vite build && echo '\\nðŸ“Š Bundle analysis complete. Check dist/ folder sizes or use a tool like webpack-bundle-analyzer on the dist folder.'",
        "release:prepare": "node scripts/prepare-release.js",
        "task:complete": "node scripts/complete-task.js",
        "task:rename-done": "node scripts/complete-task.js --rename-existing",
        "convert:validation-fixtures": "node scripts/convert-validation-to-fixtures.js",
        "license:summary": "node scripts/generate-license-summary-index.mjs && npm run -s license:check-sync",
        "license:summary:check": "node scripts/generate-license-summary-index.mjs --check",
        "license:check-sync": "node scripts/check-third-party-license-sync.mjs",
        "mem:start": "cd %USERPROFILE%\\.claude-mem && npx pm2 start ecosystem.config.cjs",
        "mem:stop": "cd %USERPROFILE%\\.claude-mem && npx pm2 stop claude-mem-worker",
        "mem:restart": "cd %USERPROFILE%\\.claude-mem && npx pm2 restart claude-mem-worker",
        "mem:status": "cd %USERPROFILE%\\.claude-mem && npx pm2 status",
        "mem:logs": "cd %USERPROFILE%\\.claude-mem && npx pm2 logs claude-mem-worker",
        "graphify:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/graphify-watch.ps1",
        "graphify:watch:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/graphify-watch.ps1 -ValidateOnly",
        "graphify:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/graphify-watch.ps1 -RebuildOnce"
    },
